{
  "name": "energeo",
  "version": "0.1.0",
  "type": "module",
  "description": "Power-sector data on a map: reusable scalar/vector map widgets with ArcGIS interop",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@terraformer/arcgis": "^2.2.2",
    "maplibre-gl": "^6.15.0",
    "papaparse": "^5.7.0",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20.14.0",
    "@types/papaparse": "^5.5.2",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.5.1",
    "typescript": "~5.6.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.1.10"
  }
}
