  "transforms": [
    {
      "id": "c32a8f85-125e-40f9-94f2-2e6e3d5ce1ef",
      "name": "1 Clean county income",
      "inputs": [
        {
          "datasetId": "99565af8-02ea-4a00-a795-6415da9acf9e",
          "alias": "inc"
        }
      ],
      "outputs": [
        {
          "key": "out",
          "name": "Clean county income",
          "sql": "-- One row per county: its median household income; placeholder values (zero or below) become NULL.\nSELECT\n  GEOID AS fips,\n  CASE WHEN median_hh_income > 0 THEN median_hh_income END AS median_hh_income\nFROM inc",
          "outputId": "254b58fd-aaa9-4dbf-b6c3-6fc7522e1605"
        }
      ]
    },
    {
      "id": "21cb2033-ffab-469d-a365-fbe9de9b003f",
      "name": "2 State income",
      "inputs": [
        {
          "datasetId": "8fbe15e1-9441-43c5-ac64-6233c54a77b7",
          "alias": "c"
        },
        {
          "datasetId": "254b58fd-aaa9-4dbf-b6c3-6fc7522e1605",
          "alias": "i"
        }
      ],
      "outputs": [
        {
          "key": "out",
          "name": "State income",
          "sql": "-- Per state: how many counties report an income, and their plain average.\nSELECT\n  c.state_fips,\n  any_value(c.state) AS state,\n  count(i.median_hh_income) AS counties,\n  round(avg(i.median_hh_income), 0) AS avg_median_hh_income\nFROM c\nLEFT JOIN i ON i.fips = c.fips\nGROUP BY c.state_fips",
          "outputId": "7c4b417d-1a5b-4c63-9b0e-5d42120e922e"
        }
      ]
    },
    {
      "id": "e3c5e51a-7d65-40d1-bb58-552fcec3707c",
      "name": "3 State income map",
      "inputs": [
        {
          "datasetId": "d1d739d8-55b7-4419-a001-b4f526c22993",
          "alias": "st"
        },
        {
          "datasetId": "7c4b417d-1a5b-4c63-9b0e-5d42120e922e",
          "alias": "s"
        }
      ],
      "outputs": [
        {
          "key": "out",
          "name": "State income map",
          "sql": "-- State shapes with their average, ready to map.\nSELECT\n  st.fips AS state_fips,\n  st.name AS state_name,\n  s.counties,\n  s.avg_median_hh_income,\n  st.geometry\nFROM st\nLEFT JOIN s ON s.state_fips = st.fips",
          "outputId": "657a9f2a-d707-46a0-af50-408b86935791"
        }
      ]
    }
  ],
